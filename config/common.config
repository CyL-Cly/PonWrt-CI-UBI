# Shared runtime choices for the Nokia XG-040G-TF (AN7581) firmware.
# Hardware drivers come from the upstream profile definition; only the symbols
# below are requested by this CI.

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_PACKAGE_kmod-dummy=y

# Keep the reset button and the status LEDs working during recovery.
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# Ethernet PHYs. kmod-phy-airoha-en8811h is the PHY used by this board and is
# additionally forced by the upstream profile; the other two are opportunistic
# and are listed in requested-packages-dropped.txt when the feed lacks them.
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_kmod-phy-maxlinear=y
CONFIG_PACKAGE_kmod-phy-realtek=y

# Userspace regulator consumers. The upstream XG-040G-TF profile removes this
# one again with a "-" prefix, so the request is opportunistic.
CONFIG_PACKAGE_kmod-regulator-userspace-consumer=y

# ext4 support, kept for a manually attached filesystem.
CONFIG_PACKAGE_kmod-fs-ext4=y

# Airoha NPU management page, imported from source by scripts/customize.sh.
CONFIG_PACKAGE_luci-app-airoha-npu=y

# TLS trust store and a minimal editor for first boot and rescue.
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_nano=y

# Never ship the vendor driver.
CONFIG_PACKAGE_vlmcsd=n
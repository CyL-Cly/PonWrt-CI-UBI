# Flash maintenance and traffic offload for the Nokia XG-040G-TF (AN7581).
#
# This board has no USB port and no disk, so only UBI/NAND tooling is kept. It is
# what allows reading back or rewriting the bosa/ri calibration partitions and
# recovering a bricked unit from the U-Boot prompt.

CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
# Raw MTD write access, required by nandwrite and ubiupdatevol.
CONFIG_PACKAGE_kmod-mtd-rw=y

# Use the full dnsmasq variant instead of the small one to avoid installing
# conflicting providers.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# The onboard PON stack. These four packages are additionally forced by the
# upstream nokia_xg-040g-tf-ubi device definition and cannot be deselected; they
# are kept explicit here so the publication gates keep verifying them. They stay
# completely idle while the fibre port is unused.
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y

# Full userland helpers.
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ip-full=y

# Transparent bridge offload, WireGuard, cake queueing and BBR.
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
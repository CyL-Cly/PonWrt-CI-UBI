# Runtime package set for the Nokia XG-040G-TF (AN7581) firmware.
#
# Only system-essential components are selected here. Third-party applications,
# USB storage stacks, disk/partition/NVMe tooling, the Ruby stack and extra file
# systems are intentionally absent, so nothing in this file may rely on them.
#
# Build-only switches (CONFIG_TARGET_MULTI_PROFILE, CONFIG_TARGET_PER_DEVICE_ROOTFS,
# CONFIG_TARGET_ALL_PROFILES) are produced by scripts/devices.py and must not be
# set here.

# LuCI collection. It pulls in the admin modules for Network, System and Status
# plus the Firewall and Package Manager applications; luci-base alone only
# provides the core runtime and cannot expose those menus. The menu packages are
# also requested one by one so the publication gate can verify each of them.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_kmod-tun=y

# Keep the stock Wake-on-LAN application out of the image.
CONFIG_PACKAGE_luci-app-wol=n

# Simplified Chinese LuCI: the language symbol selects the translation set at
# build time, luci-i18n-base-zh-cn carries the base strings.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# LuCI web server.
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y

# LuCI runtime libraries.
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-proto-relay=y

# Kernel modules: placeholder driver, socket diagnostics and NAT support.
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-inet-mptcp-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-nft-connlimit=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-netdev=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-socket=y

# Utilities and runtime components.
CONFIG_PACKAGE_autocore=y
# The current feed provides autocore for ARM; autocore-arm no longer exists.
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_xz-utils=y